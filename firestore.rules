rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net - deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Match /users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Match /settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Match /inventaris collection
    match /inventaris/{inventarisId} {
      allow read, write: if true;
    }

    // Match /categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Match /piket collection
    match /piket/{piketId} {
      allow read, write: if true;
    }

    // Match /proker collection
    match /proker/{prokerId} {
      allow read, write: if true;
    }
  }
}
